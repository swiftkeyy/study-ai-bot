# ------------------------------------------------------------------ Telegram
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMIN_ID=123456789
# Username of the bot without @ (used in referral links). Optional: if empty, the
# bot asks Telegram for it on startup.
BOT_USERNAME=studyai_rubot

# ------------------------------------------------------------------ Storage
# Where bot.db and bot.log live. Relative paths are resolved from the project
# folder; in Docker the usual value is /app/data (mount a volume there!).
DATA_DIR=./data
# Full paths, if the defaults derived from DATA_DIR do not suit you.
# DB_PATH=./data/bot.db
# LOG_FILE=./data/bot.log
LOG_LEVEL=INFO

# ------------------------------------------------------------------ AI keys
# At least one of these is required; providers are tried in order.
MISTRAL_API_KEY=PASTE_MISTRAL_KEY_HERE
GEMINI_API_KEY=PASTE_GEMINI_KEY_HERE
GROQ_API_KEY=PASTE_GROQ_KEY_HERE
OPENROUTER_API_KEY=PASTE_OPENROUTER_KEY_HERE
# Only needed for image generation (image_ai.py), not for solving by photo.
DEEPAI_API_KEY=

# ------------------------------------------------------------------ AI models
MISTRAL_API_BASE=https://api.mistral.ai
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=mistral-small-latest

OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------ Нагрузка
# Сколько одновременных соединений к AI-провайдерам разрешено (backpressure).
AI_CONNECTION_LIMIT=30
# Таймаут одного AI-запроса, сек.
AI_CONNECTION_TIMEOUT=90
# Сколько обновлений бот обрабатывает параллельно (остальные ждут в очереди).
MAX_CONCURRENT_UPDATES=64
# Ротация лога: размер файла и число архивов (0 = только консоль).
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# ------------------------------------------------------------------ Defaults
DEFAULT_FREE_LIMIT=3
DEFAULT_FREE_IMAGE_LIMIT=0
DEFAULT_REFERRAL_BONUS=5

DEFAULT_STARS_PRICE_3=59
DEFAULT_STARS_PRICE_7=99
DEFAULT_STARS_PRICE_30=199
DEFAULT_RUB_PRICE_3=99
DEFAULT_RUB_PRICE_7=199
DEFAULT_RUB_PRICE_30=499

# Link shown in the "Новости" section.
DEFAULT_NEWS_CHANNEL_URL=https://t.me/studyai_rubot

# ------------------------------------------------------------------ Robokassa
ROBOKASSA_MERCHANT_LOGIN=PASTE_LOGIN_HERE
ROBOKASSA_PASSWORD1=PASTE_PASSWORD1_HERE
ROBOKASSA_PASSWORD2=PASTE_PASSWORD2_HERE
# md5 or sha256 — must match the algorithm in the merchant profile.
ROBOKASSA_HASH_ALGO=md5
# 1 = test payments, 0 = production
ROBOKASSA_IS_TEST=1
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
# Public HTTPS address of this server (result/success URLs point here). Required
# for receipt payments: the bot serves /robokassa/pay. Leave empty to redirect to
# Robokassa directly.
ROBOKASSA_PUBLIC_BASE_URL=
# Internal HTTP server with the payment webhook.
ROBOKASSA_WEBHOOK_HOST=0.0.0.0
ROBOKASSA_WEBHOOK_PORT=8081

# 54-ФЗ receipts
ROBOKASSA_RECEIPT_ENABLED=1
ROBOKASSA_RECEIPT_TAX=none
ROBOKASSA_RECEIPT_PAYMENT_METHOD=full_payment
ROBOKASSA_RECEIPT_PAYMENT_OBJECT=service
# ROBOKASSA_RECEIPT_SNO=osn
# Log the signature source string (without real passwords) when debugging signatures.
ROBOKASSA_DEBUG_SIGNATURE=0
